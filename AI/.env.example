APP_NAME=naeda-ai-internal
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

ARCFACE_MODEL_NAME=buffalo_l
ARCFACE_PROVIDER=CPUExecutionProvider
AI_TIMEOUT_SECONDS=5.0

# Back -> AI internal call auth header value.
# Back must send: X-Service-Token: <value>
INTERNAL_SERVICE_TOKEN=dev-internal-token

# ID card OCR provider: mock|paddleocr|disabled
RESIDENT_OCR_PROVIDER=mock

# Chat (AI-019)
OPENAI_API_KEY=zzz
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=zzz
