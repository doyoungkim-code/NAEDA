# ==============================================
# PostgreSQL 설정
# ==============================================
POSTGRES_DB=naeda
POSTGRES_USER=naedauser
POSTGRES_PASSWORD=naeda1234!
POSTGRES_PORT=5432

# ==============================================
# Redis 설정
# ==============================================
REDIS_PORT=6379
REDIS_PASSWORD=redis1234!

# ==============================================
# AI 서버 설정
# ==============================================
AI_PORT=8000
AI_SERVICE_TOKEN=dev-internal-token
AI_TIMEOUT_SECONDS=5

# ==============================================
# Spring 로컬 실행용 (application.yml이 참조)
# .env 파일을 naeda/ 루트에도 복사해서 사용하거나
# IntelliJ EnvFile 플러그인으로 이 파일 직접 지정 가능
# ==============================================
AI_BASE_URL=http://localhost:8000
SSAFY_API_KEY=여기에_SSAFY_API_KEY_입력
FACE_ENCRYPT_KEY=여기에_32자_이상의_암호화키_입력
